// Interview Tracker schema.
//
// Conventions that keep this file compatible with the production Turso
// database (created by scripts/migrate.mjs, not by Prisma Migrate):
//   - Timestamps are ISO 8601 strings stored in TEXT columns. Prisma's
//     SQLite DateTime mapping writes integers, which would not read back
//     cleanly next to the text values already in production.
//   - Booleans are INTEGER 0/1 columns.
//   - Any change here must be mirrored as an idempotent statement in
//     scripts/migrate.mjs, which runs on every deploy and on `npm run db:setup`.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  passwordHash String? // null for Google-only accounts
  name         String?
  image        String? // avatar URL from Google
  googleId     String? @unique

  createdAt String
  updatedAt String

  opportunities Opportunity[]
  contacts      Contact[]
  activities    Activity[]
  documents     Document[]
  profile       UserProfile?
}

model UserProfile {
  id            String  @id @default(cuid())
  userId        String  @unique
  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  resumeText    String?
  linkedInAbout String?
  linkedInUrl   String?
  createdAt     String
  updatedAt     String
}

model Opportunity {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Core fields
  company  String
  role     String
  jdLink   String?
  jdText   String? // cached plain-text job description, filled by the JD parser
  website  String? // company website for logo matching
  compMin  Int? // in thousands USD
  compMax  Int?
  location String?
  remote   Boolean @default(false)

  // Assessment
  fitScore   Int? // 0-100, user supplied
  totalScore Float?
  priority   String @default("medium") // high | medium | low
  tier       Int? // 1-3

  // Status tracking
  status      String  @default("saved") // saved | applied | interviewing | offer | rejected | withdrawn | archived
  appliedDate String?
  source      String? // referral | direct | recruiter | job_board
  followUpAt  String? // explicit reminder date; the sidebar also infers stale ones

  // Notes
  notes         String?
  prosConsNotes String?
  keyGaps       String?

  createdAt String
  updatedAt String

  interviews          Interview[]
  activities          Activity[]
  opportunityContacts OpportunityContact[]
  documentsSent       OpportunityDocument[]
  offer               Offer?
  preps               InterviewPrep[]

  @@index([userId, status])
  @@index([userId, company])
}

model Offer {
  id            String      @id @default(cuid())
  opportunityId String      @unique
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  // Comp, all in thousands USD where numeric
  baseComp     Int?
  signOnBonus  Int?
  annualBonus  Int?
  bonusPercent Float?

  // Equity
  equityType   String?
  equityValue  Int?
  equityShares Int?
  vestYears    Int?
  vestCliff    Int?
  vestSchedule String?

  // Benefits and role
  ptoDays      Int?
  healthcare   String?
  remotePolicy String?
  startDate    String?
  expiryDate   String?
  location     String?
  title        String?
  level        String?
  benefits     String?

  rawText    String?
  sourceType String?
  aiSummary  String?

  createdAt String
  updatedAt String
}

model Interview {
  id            String      @id @default(cuid())
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  round       String
  roundNumber Int     @default(1)
  dateTime    String?
  durationMin Int?
  format      String  @default("video") // phone | video | onsite | async

  interviewerName     String?
  interviewerTitle    String?
  interviewerLinkedIn String?

  prepNotes      String?
  debriefNotes   String?
  questionsAsked String?
  questionsToAsk String?

  status    String  @default("scheduled") // scheduled | completed | cancelled | rescheduled
  sentiment String? // positive | neutral | negative
  nextSteps String?

  createdAt String
  updatedAt String

  preps     InterviewPrep[]
  followUps FollowUpDraft[]

  @@index([opportunityId])
}

/// A generated prep sheet. Stored as structured JSON so later rounds can
/// read the gaps and questions flagged in earlier rounds.
model InterviewPrep {
  id            String      @id @default(cuid())
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  interviewId   String?
  interview     Interview?  @relation(fields: [interviewId], references: [id], onDelete: SetNull)

  content       String // JSON matching PrepSheet in src/lib/ai/prep.ts
  model         String
  promptVersion Int    @default(1)
  inputTokens   Int?
  outputTokens  Int?

  createdAt String

  @@index([opportunityId])
}

/// A generated follow-up email draft tied to an interview round.
model FollowUpDraft {
  id          String    @id @default(cuid())
  interviewId String
  interview   Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  subject String
  body    String
  model   String
  sentAt  String?

  createdAt String

  @@index([interviewId])
}

model Contact {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name     String
  title    String?
  company  String?
  email    String?
  phone    String?
  linkedIn String?

  type   String  @default("other") // recruiter | hiring_manager | referral | peer | mentor | other
  warmth String? // cold | warm | hot
  notes  String?

  lastContactedAt String?
  createdAt       String
  updatedAt       String

  opportunityContacts OpportunityContact[]

  @@index([userId])
}

model OpportunityContact {
  id            String      @id @default(cuid())
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  contactId     String
  contact       Contact     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  role          String? // their role in this opportunity

  @@unique([opportunityId, contactId])
}

model Activity {
  id            String       @id @default(cuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)

  type        String // applied | emailed | interviewed | followed_up | researched | offer_received | rejected | withdrew | note | status_change
  description String
  date        String

  createdAt String

  @@index([userId, date])
  @@index([opportunityId])
}

model Document {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type     String // resume | cover_letter | portfolio | references | other
  name     String
  version  String?
  notes    String?
  filePath String?

  createdAt String
  updatedAt String

  sentTo OpportunityDocument[]

  @@index([userId])
}

model OpportunityDocument {
  id            String      @id @default(cuid())
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  documentId    String
  document      Document    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  sentAt        String

  @@unique([opportunityId, documentId])
}

/// Fixed-window counters for login rate limiting. Lives in the database so
/// the limit holds across server instances and restarts.
model RateLimit {
  key     String @id
  count   Int
  resetAt String
}
