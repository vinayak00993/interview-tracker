# Database. Local dev uses a SQLite file (relative to the prisma/ folder).
DATABASE_URL="file:./dev.db"
# Production uses Turso. When TURSO_DATABASE_URL is set it wins over DATABASE_URL.
# TURSO_DATABASE_URL="libsql://your-db.turso.io"
# TURSO_AUTH_TOKEN=""

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-random-secret-string-at-least-32-chars"

# Google sign-in (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Claude API. Required for prep, follow-ups, OCR, and the offer advisor.
ANTHROPIC_API_KEY=""
